{
  "expo": {
    "name": "VITAS Ambient Recorder",
    "slug": "vitas-ambient-recorder",
    "scheme": "vitas-ambient-recorder",
    "version": "1.0.0",
    "orientation": "portrait",
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-vitas.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0621"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sym.vitasambientrecorder",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B21B6"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_PHONE_STATE"
      ],
      "package": "com.sym.vitasambientrecorder"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Allow VITAS Ambient Recorder to access your microphone."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f053d988-e9ad-4acf-900e-726fa0a9549b"
      }
    },
    "owner": "vitas-healthcare",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f053d988-e9ad-4acf-900e-726fa0a9549b"
    }
  }
}
