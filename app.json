{
  "expo": {
    "name": "VITAS Ambient Recorder",
    "slug": "vitas-ambient-recorder",
    "scheme": "vitas-ambient-recorder",
    "version": "1.0.0",
    "orientation": "portrait",
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-vitas.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0621"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B21B6"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_PHONE_STATE"
      ],
      "package": "com.anonymous.vitasambientrecorder"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Allow VITAS Ambient Recorder to access your microphone."
        }
      ]
    ]
  }
}
